export
function w $iadd(l %a, l %b, w %k, w %n) {
@start
@head
	%i =w phi @start 0, @latch %i2
	%c =w csltw %i, %n
	jnz %c, @body, @done
@body
	%t =l extsw %i
	%o =l mul %t, 4
	%pb =l add %b, %o
	%x =w loadsw %pb
	%y =w add %x, %k
	%pa =l add %a, %o
	storew %y, %pa
	jmp @latch
@latch
	%i2 =w add %i, 1
	jmp @head
@done
	ret 0
}

export
function w $dscale(l %a, l %b, w %n) {
@start
@head
	%i =w phi @start 0, @latch %i2
	%c =w csltw %i, %n
	jnz %c, @body, @done
@body
	%t =l extsw %i
	%o =l mul %t, 8
	%pb =l add %b, %o
	%x =d loadd %pb
	%y =d mul %x, d_2.5
	%pa =l add %a, %o
	stored %y, %pa
	jmp @latch
@latch
	%i2 =w add %i, 1
	jmp @head
@done
	ret 0
}

export
function w $dinc(l %a, w %n) {
@start
@head
	%i =w phi @start 0, @latch %i2
	%c =w csltw %i, %n
	jnz %c, @body, @done
@body
	%t =l extsw %i
	%o =l mul %t, 8
	%pa =l add %a, %o
	%x =d loadd %pa
	%y =d add %x, d_1.0
	stored %y, %pa
	jmp @latch
@latch
	%i2 =w add %i, 1
	jmp @head
@done
	ret 0
}

export
function w $fadd(l %a, l %b, l %c, w %n) {
@start
@head
	%i =w phi @start 0, @latch %i2
	%c0 =w csltw %i, %n
	jnz %c0, @body, @done
@body
	%t =l extsw %i
	%o =l mul %t, 4
	%pb =l add %b, %o
	%x =s loads %pb
	%pc =l add %c, %o
	%y =s loads %pc
	%z =s add %x, %y
	%pa =l add %a, %o
	stores %z, %pa
	jmp @latch
@latch
	%i2 =w add %i, 1
	jmp @head
@done
	ret
}

