# 256-bit (AVX2) loops, qbe -V -Y: int32 and float32 element-wise loops, eight lanes each, with the
# scalar tail for the trip counts that are not a multiple of eight.

export
function w $wmad(l %a, l %b, w %k, w %n) {
@start
@head
	%i =w phi @start 0, @latch %i2
	%c =w csltw %i, %n
	jnz %c, @body, @done
@body
	%t =l extsw %i
	%o =l mul %t, 4
	%pb =l add %b, %o
	%x =w loadsw %pb
	%m =w mul %x, 3
	%y =w add %m, %k
	%pa =l add %a, %o
	storew %y, %pa
	jmp @latch
@latch
	%i2 =w add %i, 1
	jmp @head
@done
	ret 0
}

export
function w $wsub(l %a, l %b, l %c, w %n) {
@start
@head
	%i =w phi @start 0, @latch %i2
	%c0 =w csltw %i, %n
	jnz %c0, @body, @done
@body
	%t =l extsw %i
	%o =l mul %t, 4
	%pb =l add %b, %o
	%pc =l add %c, %o
	%x =w loadsw %pb
	%z =w loadsw %pc
	%y =w sub %x, %z
	%pa =l add %a, %o
	storew %y, %pa
	jmp @latch
@latch
	%i2 =w add %i, 1
	jmp @head
@done
	ret 0
}

export
function w $fscale(l %a, l %b, w %n) {
@start
@head
	%i =w phi @start 0, @latch %i2
	%c =w csltw %i, %n
	jnz %c, @body, @done
@body
	%t =l extsw %i
	%o =l mul %t, 4
	%pb =l add %b, %o
	%x =s loads %pb
	%y =s mul %x, s_2.5
	%pa =l add %a, %o
	stores %y, %pa
	jmp @latch
@latch
	%i2 =w add %i, 1
	jmp @head
@done
	ret 0
}

export
function w $winplace(l %a, w %n) {
@start
@head
	%i =w phi @start 0, @latch %i2
	%c =w csltw %i, %n
	jnz %c, @body, @done
@body
	%t =l extsw %i
	%o =l mul %t, 4
	%pa =l add %a, %o
	%x =w loadsw %pa
	%m =w mul %x, 3
	%y =w add %m, 1
	storew %y, %pa
	jmp @latch
@latch
	%i2 =w add %i, 1
	jmp @head
@done
	ret 0
}

