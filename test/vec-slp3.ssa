# Straight-line SLP of two doubles across two bases (qbe -V): the overlap test at run time, as vec-slp2.
export
function w $slpd(l %a, l %b) {
@start
	%p1 =l add %b, 8
	%x0 =d loadd %b
	%x1 =d loadd %p1
	%y0 =d mul %x0, d_2.0
	%y1 =d mul %x1, d_2.0
	%z0 =d add %y0, d_1.0
	%z1 =d add %y1, d_1.0
	stored %z0, %a
	%q1 =l add %a, 8
	stored %z1, %q1
	ret 0
}

