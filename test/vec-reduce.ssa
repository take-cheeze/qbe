export
function w $isum(l %a, w %n, w %init) {
@start
@head
	%i =w phi @start 0, @latch %i2
	%s =w phi @start %init, @latch %s2
	%c =w csltw %i, %n
	jnz %c, @body, @done
@body
	%t =l extsw %i
	%o =l mul %t, 4
	%pa =l add %a, %o
	%x =w loadsw %pa
	%s2 =w add %s, %x
	jmp @latch
@latch
	%i2 =w add %i, 1
	jmp @head
@done
	ret %s
}
