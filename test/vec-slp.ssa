# Straight-line SLP: four stores to consecutive elements of one array, each the same element-wise
# expression of the four loads of that array (the values are in place, so no run-time test is needed).

export
function w $slp4(l %a) {
@start
	%p1 =l add %a, 4
	%p2 =l add %a, 8
	%p3 =l add %a, 12
	%x0 =w loadsw %a
	%x1 =w loadsw %p1
	%x2 =w loadsw %p2
	%x3 =w loadsw %p3
	%y0 =w xor %x0, 5
	%y1 =w xor %x1, 5
	%y2 =w xor %x2, 5
	%y3 =w xor %x3, 5
	%z0 =w add %y0, 3
	%z1 =w add %y1, 3
	%z2 =w add %y2, 3
	%z3 =w add %y3, 3
	storew %z0, %a
	storew %z1, %p1
	storew %z2, %p2
	storew %z3, %p3
	ret 0
}

