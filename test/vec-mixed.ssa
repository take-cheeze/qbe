# Mixed int and double lanes: the int-to-double and double-to-int conversions in the body. The loop is two
# lanes wide then (the int loads and stores move 64 bits).

export
function w $itod(l %a, l %d, w %n) {
@start
@head
	%i =w phi @start 0, @latch %i2
	%c =w csltw %i, %n
	jnz %c, @body, @done
@body
	%t =l extsw %i
	%o =l mul %t, 4
	%pa =l add %a, %o
	%x =w loadsw %pa
	%y =d swtof %x
	%h =d mul %y, d_0.5
	%o8 =l mul %t, 8
	%pd =l add %d, %o8
	stored %h, %pd
	jmp @latch
@latch
	%i2 =w add %i, 1
	jmp @head
@done
	ret 0
}

export
function w $dtoi(l %d, l %a, w %n) {
@start
@head
	%i =w phi @start 0, @latch %i2
	%c =w csltw %i, %n
	jnz %c, @body, @done
@body
	%t =l extsw %i
	%o8 =l mul %t, 8
	%pd =l add %d, %o8
	%y =d loadd %pd
	%h =d add %y, d_1.5
	%x =w dtosi %h
	%o =l mul %t, 4
	%pa =l add %a, %o
	storew %x, %pa
	jmp @latch
@latch
	%i2 =w add %i, 1
	jmp @head
@done
	ret 0
}

