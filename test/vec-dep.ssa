# Same-base dependences at constant distances: a store to a[i+d] and a load of a[i] are vectorized
# when |d| is 0 or at least the vector width (here 8 and 0), and refused when 0 < |d| < 4 (here 2).

export
function w $dist8(l %a, w %n) {
@start
@head
	%i =w phi @start 0, @latch %i2
	%c =w csltw %i, %n
	jnz %c, @body, @done
@body
	%t =l extsw %i
	%o =l mul %t, 4
	%pl =l add %a, %o
	%x =w loadsw %pl
	%y =w add %x, 1
	%o8 =l add %o, 32
	%ps =l add %a, %o8
	storew %y, %ps
	jmp @latch
@latch
	%i2 =w add %i, 1
	jmp @head
@done
	ret 0
}

export
function w $dist2(l %a, w %n) {
@start
@head
	%i =w phi @start 0, @latch %i2
	%c =w csltw %i, %n
	jnz %c, @body, @done
@body
	%t =l extsw %i
	%o =l mul %t, 4
	%pl =l add %a, %o
	%x =w loadsw %pl
	%y =w add %x, 1
	%o2 =l add %o, 8
	%ps =l add %a, %o2
	storew %y, %ps
	jmp @latch
@latch
	%i2 =w add %i, 1
	jmp @head
@done
	ret 0
}

