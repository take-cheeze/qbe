# Float and double sums, vectorized with -F (they reassociate). The data are small integers,
# so every partial sum is exact and the driver can compare with a sequential sum.

export
function s $fsum(l %a, w %n, s %init) {
@start
@head
	%i =w phi @start 0, @latch %i2
	%s =s phi @start %init, @latch %s2
	%c =w csltw %i, %n
	jnz %c, @body, @done
@body
	%t =l extsw %i
	%o =l mul %t, 4
	%pa =l add %a, %o
	%x =s loads %pa
	%s2 =s add %s, %x
	jmp @latch
@latch
	%i2 =w add %i, 1
	jmp @head
@done
	ret %s
}

export
function d $dsum(l %a, w %n, d %init) {
@start
@head
	%i =w phi @start 0, @latch %i2
	%s =d phi @start %init, @latch %s2
	%c =w csltw %i, %n
	jnz %c, @body, @done
@body
	%t =l extsw %i
	%o =l mul %t, 8
	%pa =l add %a, %o
	%x =d loadd %pa
	%s2 =d add %s, %x
	jmp @latch
@latch
	%i2 =w add %i, 1
	jmp @head
@done
	ret %s
}

