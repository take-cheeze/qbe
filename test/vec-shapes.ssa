# a constant bound: vectorized
export
function w $cbound(l %a, l %b) {
@start
@head
	%i =w phi @start 0, @latch %i2
	%c =w csltw %i, 13
	jnz %c, @body, @done
@body
	%t =l extsw %i
	%o =l mul %t, 4
	%pb =l add %b, %o
	%x =w loadsw %pb
	%y =w add %x, 9
	%pa =l add %a, %o
	storew %y, %pa
	jmp @latch
@latch
	%i2 =w add %i, 1
	jmp @head
@done
	ret 0
}
# a call in the loop: refused
export
function w $callin(l %a, w %n) {
@start
@head
	%i =w phi @start 0, @latch %i2
	%c =w csltw %i, %n
	jnz %c, @body, @done
@body
	%t =l extsw %i
	%o =l mul %t, 4
	%pa =l add %a, %o
	%x =w call $abs(w %i)
	storew %x, %pa
	jmp @latch
@latch
	%i2 =w add %i, 1
	jmp @head
@done
	ret 0
}
# a body value used after the loop: refused
export
function w $liveout(l %a, l %b, w %n) {
@start
@head
	%i =w phi @start 0, @latch %i2
	%c =w csltw %i, %n
	jnz %c, @body, @done
@body
	%t =l extsw %i
	%o =l mul %t, 4
	%pb =l add %b, %o
	%x =w loadsw %pb
	%pa =l add %a, %o
	storew %x, %pa
	jmp @latch
@latch
	%i2 =w add %i, 1
	jmp @head
@done
	ret %x
}

