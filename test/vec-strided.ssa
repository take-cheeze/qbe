# Stride-2 accesses: a[2*i] read (two vector loads and a shuffle) and written (the even lanes merged
# into two vectors, the odd lanes kept), for int, float and double elements.

export
function w $s2load(l %a, l %b, w %n) {
@start
@head
	%i =w phi @start 0, @latch %i2
	%c =w csltw %i, %n
	jnz %c, @body, @done
@body
	%t =l extsw %i
	%o =l mul %t, 8
	%pa =l add %a, %o
	%x =w loadsw %pa
	%y =w add %x, 1
	%ob =l mul %t, 4
	%pb =l add %b, %ob
	storew %y, %pb
	jmp @latch
@latch
	%i2 =w add %i, 1
	jmp @head
@done
	ret 0
}

export
function w $s2store(l %a, l %b, w %n) {
@start
@head
	%i =w phi @start 0, @latch %i2
	%c =w csltw %i, %n
	jnz %c, @body, @done
@body
	%t =l extsw %i
	%ob =l mul %t, 4
	%pb =l add %b, %ob
	%x =w loadsw %pb
	%y =w add %x, 3
	%o =l mul %t, 8
	%pa =l add %a, %o
	storew %y, %pa
	jmp @latch
@latch
	%i2 =w add %i, 1
	jmp @head
@done
	ret 0
}

export
function s $fs2(l %a, l %b, w %n) {
@start
@head
	%i =w phi @start 0, @latch %i2
	%c =w csltw %i, %n
	jnz %c, @body, @done
@body
	%t =l extsw %i
	%o =l mul %t, 8
	%pa =l add %a, %o
	%x =s loads %pa
	%ob =l mul %t, 4
	%pb =l add %b, %ob
	stores %x, %pb
	jmp @latch
@latch
	%i2 =w add %i, 1
	jmp @head
@done
	ret
}

export
function w $ds2(l %a, l %b, w %n) {
@start
@head
	%i =w phi @start 0, @latch %i2
	%c =w csltw %i, %n
	jnz %c, @body, @done
@body
	%t =l extsw %i
	%o =l mul %t, 16
	%pa =l add %a, %o
	%x =d loadd %pa
	%ob =l mul %t, 8
	%pb =l add %b, %ob
	stored %x, %pb
	jmp @latch
@latch
	%i2 =w add %i, 1
	jmp @head
@done
	ret 0
}

