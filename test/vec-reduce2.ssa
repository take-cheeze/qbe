export
function w $multi(l %a, l %b, w %n, w %x0, w %y0, w %z0) {
@start
@head
	%i =w phi @start 0, @latch %i2
	%xs =w phi @start %x0, @latch %xs2
	%ys =w phi @start %y0, @latch %ys2
	%zs =w phi @start %z0, @latch %zs2
	%c =w csltw %i, %n
	jnz %c, @body, @done
@body
	%t =l extsw %i
	%o =l mul %t, 4
	%pa =l add %a, %o
	%pb =l add %b, %o
	%u =w loadsw %pa
	%v =w loadsw %pb
	%xs2 =w xor %xs, %u
	%ys2 =w and %ys, %u
	%zs2 =w or %zs, %v
	%w =w add %u, 1
	storew %w, %pb
	jmp @latch
@latch
	%i2 =w add %i, 1
	jmp @head
@done
	%r1 =w add %xs, %ys
	%r2 =w add %r1, %zs
	ret %r2
}
