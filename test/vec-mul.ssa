# int32 multiply on the vector lanes, with SSE2 only (pmuludq on the even and odd lanes).
# The products wrap; the driver checks them against C's int multiplication.

export
function w $imul3(l %a, l %b, w %k, w %n) {
@start
@head
	%i =w phi @start 0, @latch %i2
	%c =w csltw %i, %n
	jnz %c, @body, @done
@body
	%t =l extsw %i
	%o =l mul %t, 4
	%pb =l add %b, %o
	%x =w loadsw %pb
	%y =w mul %x, %k
	%pa =l add %a, %o
	storew %y, %pa
	jmp @latch
@latch
	%i2 =w add %i, 1
	jmp @head
@done
	ret 0
}

