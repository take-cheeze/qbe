export
function w $fadd(l %a, l %b, l %c, w %n) {
@start
@head
	%i =w phi @start 0, @latch %i2
	%c0 =w csltw %i, %n
	jnz %c0, @body, @done
@body
	%t =l extsw %i
	%o =l mul %t, 4
	%pb =l add %b, %o
	%x =s loads %pb
	%pc =l add %c, %o
	%y =s loads %pc
	%z =s add %x, %y
	%pa =l add %a, %o
	stores %z, %pa
	jmp @latch
@latch
	%i2 =w add %i, 1
	jmp @head
@done
	ret
}
