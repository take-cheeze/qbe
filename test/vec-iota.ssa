# The induction variable used as a value: a[i] = i + b[i], a[i] = i, and a sum of i,
# counting up and down.

export
function w $iplus(l %a, l %b, w %n) {
@start
@head
	%i =w phi @start 0, @latch %i2
	%c =w csltw %i, %n
	jnz %c, @body, @done
@body
	%t =l extsw %i
	%o =l mul %t, 4
	%pb =l add %b, %o
	%x =w loadsw %pb
	%y =w add %i, %x
	%pa =l add %a, %o
	storew %y, %pa
	jmp @latch
@latch
	%i2 =w add %i, 1
	jmp @head
@done
	ret 0
}

export
function w $istore(l %a, w %n) {
@start
@head
	%i =w phi @start 0, @latch %i2
	%c =w csltw %i, %n
	jnz %c, @body, @done
@body
	%t =l extsw %i
	%o =l mul %t, 4
	%pa =l add %a, %o
	storew %i, %pa
	jmp @latch
@latch
	%i2 =w add %i, 1
	jmp @head
@done
	ret 0
}

export
function w $isumdn(l %b, w %n) {
@start
	%i0 =w sub %n, 1
@head
	%i =w phi @start %i0, @latch %i2
	%s =w phi @start 0, @latch %s2
	%c =w csgew %i, 0
	jnz %c, @body, @done
@body
	%t =l extsw %i
	%o =l mul %t, 4
	%pb =l add %b, %o
	%x =w loadsw %pb
	%y =w add %x, %i
	%s2 =w add %s, %y
	jmp @latch
@latch
	%i2 =w sub %i, 1
	jmp @head
@done
	ret %s
}

