export function l $l_ext(w %w, w %k) {
@start
	%a =l extsw %w
	%b =l extuw %w
	%c =l extsb %w
	%d =l extub %w
	%e =l extsh %w
	%f =l extuh %w
	%r =l copy %a
	%k2 =l extsw %k
	%m =l mul %k2, 7
	%r =l xor %r, %b
	%r =l add %r, %c
	%r =l sub %r, %d
	%r =l xor %r, %e
	%r =l add %r, %f
	%r =l add %r, %m
	ret %r
}

# loads and stores, of longs and of narrower values into longs
export function l $l_mem(w %p, w %q) {
@start
	%a =l loadl %p
	%p4 =w add %p, 8
	%b =l loadsw %p4
	%c =l loaduw %p4
	%d =l loadsb %p4
	%e =l loaduh %p4
	%s =l add %a, %b
	%s =l xor %s, %c
	%s =l add %s, %d
	%s =l add %s, %e
	storel %s, %q
	%q8 =w add %q, 8
	storel 81985529216486895, %q8
	%t =w copy %s
	%q16 =w add %q, 16
	storew %t, %q16
	ret %s
}

# loops: longs in phis
export function l $l_sum(w %p, w %n) {
@start
	%s =l copy 0
	%i =w copy 0
@loop
	%c =w csltw %i, %n
	jnz %c, @body, @end
@body
	%o =w mul %i, 8
	%q =w add %p, %o
	%v =l loadl %q
	%s =l add %s, %v
	%i =w add %i, 1
	jmp @loop
@end
	ret %s
}

export function l $l_fact(w %n) {
@start
	%r =l copy 1
	%k =l extsw %n
@loop
	%c =w csgtl %k, 1
	jnz %c, @body, @end
@body
	%r =l mul %r, %k
	%k =l sub %k, 1
	jmp @loop
@end
	ret %r
}

# a long tested by jnz (its low word, as for any word use)
export function w $l_jnz(l %a) {
@start
	jnz %a, @t, @f
@t
	ret 1
@f
	ret 0
}

# arguments: a long goes in two registers when two remain
# (regparm), else on the stack with all that follow
export function l $l_args(w %a, l %b, w %c, l %d) {
@start
	%r =l extsw %a
	%r =l add %r, %b
	%x =l extsw %c
	%x =l mul %x, 1000
	%r =l add %r, %x
	%r =l xor %r, %d
	ret %r
}

export function l $l_args2(w %a, w %b, l %c, w %d) {
@start
	%x =l extsw %a
	%y =l extsw %b
	%z =l extsw %d
	%r =l add %x, %c
	%r =l mul %r, %y
	%r =l sub %r, %z
	ret %r
}

export function l $l_va(w %n, ...) {
@start
	%ap =w alloc4 4
	vastart %ap
	%a =l vaarg %ap
	%b =w vaarg %ap
	%c =l vaarg %ap
	%x =l extsw %b
	%r =l add %a, %x
	%r =l mul %r, %c
	ret %r
}

export function l $l_calls(l %a) {
@start
	%x =l call $c_args(w 1, l %a, w 3, l 81985529216486895)
	%y =l call $c_args2(w 5, w 6, l %a, w 7)
	%z =l call $c_va(w 3, ..., l %a, w -9, l 4294967296)
	%r =l add %x, %y
	%r =l xor %r, %z
	ret %r
}

