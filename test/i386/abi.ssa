# argument passing and returns, checked against gcc in both
# directions (the driver calls QBE, QBE calls the driver)

type :s1 = { b }
type :s2 = { h }
type :s3 = { b 3 }
type :s4 = { w }
type :s5 = { b 5 }
type :s8 = { w, w }
type :s12 = { w 3 }
type :s20 = { w 5 }

export function w $sum4(w %a, w %b, w %c, w %d) {
@start
	%x =w add %a, %b
	%y =w add %c, %d
	%z =w mul %y, 10
	%r =w add %x, %z
	ret %r
}

export function w $sub7(w %a, w %b, w %c, w %d, w %e, w %f, w %g) {
@start
	%r =w sub %a, %b
	%r1 =w sub %r, %c
	%r2 =w sub %r1, %d
	%r3 =w sub %r2, %e
	%r4 =w sub %r3, %f
	%r5 =w sub %r4, %g
	ret %r5
}

export function w $chars(sb %a, ub %b, sh %c, uh %d) {
@start
	%x =w add %a, %b
	%y =w add %c, %d
	%r =w add %x, %y
	ret %r
}

export function sb $retsb(w %a) {
@start
	ret %a
}

export function ub $retub(w %a) {
@start
	ret %a
}

# struct arguments: return the sum of all their bytes
function w $bsum(w %p, w %n) {
@start
	%s =w copy 0
	%i =w copy 0
@loop
	%c =w cultw %i, %n
	jnz %c, @body, @end
@body
	%q =w add %p, %i
	%b =w loadub %q
	%s =w add %s, %b
	%i =w add %i, 1
	jmp @loop
@end
	ret %s
}

export function w $take1(:s1 %a, w %x) {
@start
	%r =w call $bsum(w %a, w 1)
	%r =w add %r, %x
	ret %r
}
export function w $take3(w %x, :s3 %a) {
@start
	%r =w call $bsum(w %a, w 3)
	%r =w add %r, %x
	ret %r
}
export function w $take5(:s5 %a, w %x) {
@start
	%r =w call $bsum(w %a, w 5)
	%r =w add %r, %x
	ret %r
}
export function w $take8(w %x, :s8 %a, w %y) {
@start
	%r =w call $bsum(w %a, w 8)
	%r =w add %r, %x
	%y =w mul %y, 1000
	%r =w add %r, %y
	ret %r
}
export function w $take12(:s12 %a, w %x) {
@start
	%r =w call $bsum(w %a, w 12)
	%r =w add %r, %x
	ret %r
}
export function w $take12b(w %x, w %y, :s12 %a, w %z) {
@start
	%r =w call $bsum(w %a, w 12)
	%r =w add %r, %x
	%y =w mul %y, 100
	%r =w add %r, %y
	%z =w mul %z, 10000
	%r =w add %r, %z
	ret %r
}
export function w $take20(:s20 %a, :s2 %b, :s4 %c) {
@start
	%r =w call $bsum(w %a, w 20)
	%r1 =w call $bsum(w %b, w 2)
	%r2 =w call $bsum(w %c, w 4)
	%r =w add %r, %r1
	%r =w add %r, %r2
	ret %r
}

# struct returns: bytes v, v+1, ...
function $fill(w %p, w %n, w %v) {
@start
	%i =w copy 0
@loop
	%c =w cultw %i, %n
	jnz %c, @body, @end
@body
	%q =w add %p, %i
	%b =w add %v, %i
	storeb %b, %q
	%i =w add %i, 1
	jmp @loop
@end
	ret
}
export function :s3 $ret3(w %v) {
@start
	%p =w alloc4 4
	call $fill(w %p, w 3, w %v)
	ret %p
}
export function :s8 $ret8(w %v) {
@start
	%p =w alloc4 8
	call $fill(w %p, w 8, w %v)
	ret %p
}
export function :s20 $ret20(w %v, w %w) {
@start
	%p =w alloc4 20
	%v =w add %v, %w
	call $fill(w %p, w 20, w %v)
	ret %p
}

# calls into the driver
export function w $callc() {
@start
	%a =w call $c_sum4(w 1, w 2, w 3, w 4)
	%b =w call $c_sub7(w 100, w 1, w 2, w 3, w 4, w 5, w 6)
	%s =:s8 call $c_ret8(w 10)
	%c =w call $bsum(w %s, w 8)
	%t =:s20 call $c_ret20(w 1, w 2)
	%d =w call $bsum(w %t, w 20)
	%e =w call $c_take8(w 7, :s8 %s, w 3)
	%f =w call $c_take12b(w 1, w 2, :s12 %t, w 3)
	%u =:s3 call $c_ret3(w 50)
	%g =w call $c_take3(w 9, :s3 %u)
	%h =w call $c_chars(w -1, w 255, w -2, w 65535)
	%r =w call $c_check6(w %a, w %b, w %c, w %d, w %e, w %f)
	%r =w add %r, %g
	%r =w add %r, %h
	ret %r
}

