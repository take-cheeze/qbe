# A displaced index whose scaled value is also used after the loop: the multiply (k + 1) * 4 is one temporary for
# the address in the body and for the address after the loop (the optimizer merges the two). The induction pass gives
# the body a pointer and leaves the multiply for the use after the loop. The elements are a[i] = i + 1: the body reads
# a[1], a[2], a[3] (2 + 3 + 4) and the exit reads a[4] (5); the sum is 14.
data $arr = { w 1, w 2, w 3, w 4, w 5, w 6, w 7, w 8, w 9, w 10, w 11, w 12 }
export function w $test() {
@start
	jmp @loop
@loop
	%k =w phi @start 0, @latch %k2
	%s =w phi @start 0, @latch %s2
	%k1 =w add %k, 1
	%e =l extsw %k1
	%o =l mul %e, 4
	%c =w csltw %k, 3
	jnz %c, @body, @end
@body
	%p =l add $arr, %o
	%v =w loadsw %p
	jmp @latch
@latch
	%s2 =w add %s, %v
	%k2 =w add %k, 1
	jmp @loop
@end
	%q =l add $arr, %o
	%w =w loadsw %q
	%r =w add %s, %w
	ret %r
}

