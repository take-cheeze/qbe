# Loop shapes the vectorizer takes beyond the counted-up int loop: a loop counting down with
# an >= exit (dn), a <= exit (le), and a 64-bit induction variable (lg).

export
function w $dn(l %a, l %b, w %n) {
@start
	%i0 =w sub %n, 1
@head
	%i =w phi @start %i0, @latch %i2
	%c =w csgew %i, 0
	jnz %c, @body, @done
@body
	%t =l extsw %i
	%o =l mul %t, 4
	%pb =l add %b, %o
	%x =w loadsw %pb
	%y =w add %x, 5
	%pa =l add %a, %o
	storew %y, %pa
	jmp @latch
@latch
	%i2 =w sub %i, 1
	jmp @head
@done
	ret 0
}

export
function w $le(l %a, l %b, w %n) {
@start
@head
	%i =w phi @start 0, @latch %i2
	%c =w cslew %i, %n
	jnz %c, @body, @done
@body
	%t =l extsw %i
	%o =l mul %t, 4
	%pb =l add %b, %o
	%x =w loadsw %pb
	%y =w add %x, 7
	%pa =l add %a, %o
	storew %y, %pa
	jmp @latch
@latch
	%i2 =w add %i, 1
	jmp @head
@done
	ret 0
}

export
function w $lg(l %a, l %b, l %n) {
@start
@head
	%i =l phi @start 0, @latch %i2
	%c =l csltl %i, %n
	jnz %c, @body, @done
@body
	%o =l mul %i, 4
	%pb =l add %b, %o
	%x =w loadsw %pb
	%y =w add %x, 11
	%pa =l add %a, %o
	storew %y, %pa
	jmp @latch
@latch
	%i2 =l add %i, 1
	jmp @head
@done
	ret 0
}

