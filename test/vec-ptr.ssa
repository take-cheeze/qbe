# Pointer induction: the loop walks a pointer p from a to e, four bytes at a time (pfill updates each element
# in place, psum sums them). The accesses are through p itself.

export
function w $pfill(l %a, l %e, w %k) {
@start
@head
	%p =l phi @start %a, @latch %p2
	%c =l csltl %p, %e
	jnz %c, @body, @done
@body
	%y =w loadsw %p
	%z =w add %y, %k
	storew %z, %p
	jmp @latch
@latch
	%p2 =l add %p, 4
	jmp @head
@done
	ret 0
}

export
function w $psum(l %a, l %e) {
@start
@head
	%p =l phi @start %a, @latch %p2
	%s =w phi @start 0, @latch %s2
	%c =l csltl %p, %e
	jnz %c, @body, @done
@body
	%y =w loadsw %p
	%s2 =w add %s, %y
	jmp @latch
@latch
	%p2 =l add %p, 4
	jmp @head
@done
	ret %s
}

