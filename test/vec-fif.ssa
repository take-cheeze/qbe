# float conditions: a select on a float compare (ifopt's sel form), and a float compare guarding a store.

export
function w $fsel(l %a, l %b, l %c, w %n) {
@start
@head
	%i =w phi @start 0, @latch %i2
	%c0 =w csltw %i, %n
	jnz %c0, @body, @done
@body
	%t =l extsw %i
	%o =l mul %t, 4
	%pb =l add %b, %o
	%pc =l add %c, %o
	%x =s loads %pb
	%y =s loads %pc
	%k =w clts %x, %y
	%u =s add %x, %y
	%v =s sub %x, %y
	jnz %k, @then, @else
@then
	%p1 =s add %u, s_0.5
	jmp @join
@else
	%p2 =s mul %v, s_2.0
	jmp @join
@join
	%r =s phi @then %p1, @else %p2
	%pa =l add %a, %o
	stores %r, %pa
	jmp @latch
@latch
	%i2 =w add %i, 1
	jmp @head
@done
	ret
}

export
function w $fguard(l %a, l %b, w %n) {
@start
@head
	%i =w phi @start 0, @latch %i2
	%c0 =w csltw %i, %n
	jnz %c0, @body, @done
@body
	%t =l extsw %i
	%o =l mul %t, 4
	%pb =l add %b, %o
	%pa =l add %a, %o
	%x =s loads %pb
	%k =w cles %x, s_0.0
	jnz %k, @then, @join
@then
	%y =s add %x, s_1.0
	stores %y, %pa
	jmp @join
@join
	jmp @latch
@latch
	%i2 =w add %i, 1
	jmp @head
@done
	ret 0
}

